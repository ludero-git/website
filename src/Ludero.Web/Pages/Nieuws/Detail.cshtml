@page "/nieuws/{Slug}"
@model Ludero.Web.Pages.Nieuws.DetailModel
@using Ludero.Web.Services
@{
    ViewData["Title"] = Model.Article?.Title ?? "Artikel niet gevonden";
    ViewData["Description"] = Model.Article?.Description ?? "";
}

@if (Model.Article is null)
{
    <div class="page-header">
        <h1>Artikel niet gevonden</h1>
        <p>Het gevraagde artikel bestaat niet of is verwijderd.</p>
    </div>
    <section class="nieuws-detail-section">
        <div class="nieuws-detail-inner">
            <div class="nieuws-detail-back">
                <a class="btn btn-green" asp-page="/Nieuws/Index">&larr; Terug naar nieuws</a>
            </div>
        </div>
    </section>
}
else
{
    <div class="page-header nieuws-detail-header">
        <span class="label">@Model.Article.Date.ToString("d MMMM yyyy", new System.Globalization.CultureInfo("nl-NL"))</span>
        <h1>@Model.Article.Title</h1>
        <p>@Model.Article.Description</p>
    </div>

    <section class="nieuws-detail-section">
        <div class="nieuws-detail-inner">
            @if (!string.IsNullOrEmpty(Model.Article.Image))
            {
                var (webpSrcSet, fallbackSrcSet, fallbackSrc, fallbackType, placeholderSrc, placeholderWebpSrc) = ImageSrcSetHelper.Build(Model.Article);
                var sizes = "(max-width: 768px) 100vw, 1200px";

                <div class="nieuws-detail-hero-img-wrap">
                    @if (!string.IsNullOrEmpty(placeholderWebpSrc))
                    {
                        <picture>
                            <source type="image/webp" srcset="@placeholderWebpSrc" />
                            <img class="img-placeholder" src="@placeholderSrc" alt="" aria-hidden="true" />
                        </picture>
                    }
                    else
                    {
                        <img class="img-placeholder" src="@placeholderSrc" alt="" aria-hidden="true" />
                    }
                    @if (!string.IsNullOrEmpty(webpSrcSet))
                    {
                        <picture>
                            <source type="image/webp" srcset="@webpSrcSet" sizes="@sizes" />
                            <source type="@fallbackType" srcset="@fallbackSrcSet" sizes="@sizes" />
                            <img class="nieuws-detail-hero-img is-loading" src="@fallbackSrc" alt="@Model.Article.Title" loading="eager"
                                onload="this.classList.remove('is-loading')" />
                        </picture>
                    }
                    else
                    {
                        <img class="nieuws-detail-hero-img is-loading" src="@Model.Article.Image" alt="@Model.Article.Title" loading="eager"
                            onload="this.classList.remove('is-loading')" />
                    }
                </div>
            }
            <div class="nieuws-detail-content">
                @Html.Raw(Model.Article.ContentHtml)
            </div>
            <div class="nieuws-detail-back">
                <a class="btn btn-green" asp-page="/Nieuws/Index">&larr; Terug naar nieuws</a>
            </div>
        </div>
    </section>
}
