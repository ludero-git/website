@page "/{path}"
@model Ludero.Web.Pages.Outline.OutlinePageModel

@using System.Globalization

@{
    ViewData["Title"] = Model.PageObject?.Title ?? "Pagina niet gevonden";
    ViewData["Description"] = Model.PageObject?.Description ?? "";
}
<link href="https://cdn.jsdelivr.net/npm/simple-datatables@latest/dist/style.css" rel="stylesheet" type="text/css">
<script src="https://cdn.jsdelivr.net/npm/simple-datatables@latest" type="text/javascript"></script>

<style>
    div.info {
        border-left: 4px solid blue;
        padding: 1em;
        background: #f0f8ff;

        p {
            margin-bottom: 0;
        }
    }

    div.success {
        border-left: 4px solid green;
        padding: 1em;
        background: #f0fff0;

        p {
            margin-bottom: 0;
        }
    }

    div.error {
        border-left: 4px solid red;
        padding: 1em;
        background: #fff0f0;

        p {
            margin-bottom: 0;
        }
    }
</style>

@if (Model.PageObject is null)
{
    <div class="page-header">
        <h1>Pagina niet gevonden</h1>
        <p>De gevraagde pagina bestaat niet of is verwijderd.</p>
    </div>
}
else
{
    <div class="page-header outline-detail-header">
        @if (Model.PageObject.LastUpdated.HasValue)
        {
            <span class="label">
                Laatst bijgewerkt:
                @Model.PageObject.LastUpdated.Value.ToString(
                    "d MMMM yyyy",
                    new CultureInfo("nl-NL"))
            </span>
        }

        <h1>@Model.PageObject.Title</h1>
        <p>@Model.PageObject.Description</p>
    </div>

    <section class="outline-detail-section">
        <div class="outline-detail-inner">
            <div class="outline-detail-content">
                @Html.Raw(Model.PageObject.ContentHtml)
            </div>
        </div>
    </section>
}

<script>
document.addEventListener("DOMContentLoaded", function() {
    const tables = document.querySelectorAll(".outline-detail-section table");
    
    tables.forEach(table => {
        new simpleDatatables.DataTable(table, {
            searchable: true,
            sortable: true,
            perPage: 20
        });
    });
});
</script>